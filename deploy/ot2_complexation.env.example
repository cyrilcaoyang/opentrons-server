# Environment for the ot2_complexation gateway instance.
#
# The second opentrons-server gateway, on the UPLC PC (sdl2-pc-06-uplc), port
# 8021, fronting the "ot2training" OT-2 over lab-switch Ethernet (its own
# tailnet IP 100.64.254.91 rides unreliable Wi-Fi and is not a control path)
# for standalone complexation work (no xArm). Copy to a real .env (kept out of
# git) and fill in the secret.
# create_app() reads all of these from the process environment at startup;
# the LISTEN PORT is NOT here — it is a uvicorn arg (see DEVICE_BRINGUP.md).
#
# ── identity ────────────────────────────────────────────────────────────────
OT2_EQUIPMENT_ID=ot2_complexation
OT2_EQUIPMENT_NAME=Opentrons OT-2 (Complexation)

# ── transport ───────────────────────────────────────────────────────────────
# "http" (what both robots run since 2026-08-07) drives the robot-server
# run engine. OT2_HOST_ALIAS is still used for SSH snapshot reads; point it at
# the same path as the HTTP URL (see TRANSPORT_TRADEOFFS.md).
OT2_TRANSPORT=http
OT2_HTTP_BASE_URL=http://<robot-wired-ip>:31950   # lab-switch address; machine-local, never commit it
OT2_HOST_ALIAS=<robot-wired-ip>
OT2_SSH_PASSWORD=CHANGE_ME          # robot SSH password — do NOT commit the real value

# Fallback: the SSH REPL transport (code default when OT2_TRANSPORT is unset).
# Needs an SSH config alias for the robot reachable by the service user
# (DEVICE_BRINGUP.md §1). Set OT2_TRANSPORT=ssh and OT2_HOST_ALIAS=<alias>.
# NOTE: on the HTTP transport the gateway does NOT relay simulation to the
# robot, so the dispense test's `--mode dry` will not truly simulate there;
# use OT2_DRY_RUN=true for a hardware-free rehearsal instead.

# ── state files ─────────────────────────────────────────────────────────────
# CRITICAL: distinct from the HTE `ot2` gateway. A relative path resolves
# against the repo root, so if this instance shares the checkout with the HTE
# gateway the defaults (./ot2_state.json) would COLLIDE. Point at dedicated,
# absolute paths for this robot.
OT2_PLATE_STATE_PATH=C:/SDL_State/ot2_complexation_state.json
OT2_DECK_STATE_PATH=C:/SDL_State/ot2_complexation_deck_state.json

# ── misc ────────────────────────────────────────────────────────────────────
OT2_DRY_RUN=false                   # leave false; the test drives simulation via /control/startup
OT2_AUTO_RECONNECT=true
