# Dedicated Opentrons Flex HTTP gateway on the Gibbie PC.
#
# This file contains no credentials. NSSM receives these values as its
# AppEnvironmentExtra block; the assistant key lives in the separate file
# named by OT2_ENV_FILE.

# Identity: distinct from the read-only gibbie_flex monitor on port 8070.
OT2_EQUIPMENT_ID=gibbie_flex_http
OT2_EQUIPMENT_NAME=Opentrons Flex (Gibbie HTTP)

# Flex may only use the typed robot-server HTTP transport in this gateway.
OT2_ROBOT_MODEL=Flex
OT2_TRANSPORT=http
OT2_HTTP_BASE_URL=http://192.168.254.81:31950
OT2_HOST_ALIAS=192.168.254.81

# Every store belongs to this instance. Never share these with an OT-2 or the
# Gibbie workflow.
OT2_PLATE_STATE_PATH=C:/SDL_State/opentrons-flex-http/plate.json
OT2_DECK_STATE_PATH=C:/SDL_State/opentrons-flex-http/deck.json
OT2_TIP_STATE_PATH=C:/SDL_State/opentrons-flex-http/tips.json
OT2_STOP_STATE_PATH=C:/SDL_State/opentrons-flex-http/stop.json

# Installation is observation-only. An operator initializes from /ui later.
OT2_DRY_RUN=false
OT2_AUTO_RECONNECT=false
OT2_LOG_LEVEL=INFO

# Serve through an authenticated proxy. Provision OT2_EDGE_SECRET separately
# after approval; it is not an assistant.env setting.
OT2_UI=true
OT2_TRUST_LOCAL_UI=false
OT2_REQUIRE_LOGIN=true

# The assistant reads this allowlisted file on every request. It can read and
# propose plans only; a claimed operator must approve and execute them.
OT2_ASSISTANT_ENABLED=true
OT2_ENV_FILE=C:/SDL_State/opentrons-flex-http/assistant.env
