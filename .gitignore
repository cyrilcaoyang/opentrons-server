# Gateway UI (ui/ is the Vite source; ui_dist is committed build output)
ui/node_modules/
# Re-include ui/src/lib/ — the generic `lib/` pattern above (Python build dir
# convention) accidentally excludes the SPA's TypeScript lib source dir. The
# parent dirs (ui/src/) are not ignored, so this negation re-includes it.
!ui/src/lib/

# Persistent operator stop latch (per gateway)
ot2_stop_state.json
